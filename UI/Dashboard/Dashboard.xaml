<Page x:Class="ShopAIDesktop.UI.Dashboard.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopAIDesktop.UI.Dashboard"
      xmlns:component="clr-namespace:ShopAIDesktop.UI.Components.Sidebar"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dashboard" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <!--Sidebar-->
            <ColumnDefinition Width="240" /> 
            
            <!--Area de contenido-->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ===================================== -->
        <!--Sidebar-->
        <!-- ===================================== -->
        <ContentControl x:Name="SidebarContainer" Grid.Column="0" />


        <!-- ===================================== -->
        <!--Content-->
        <!-- ===================================== -->
        <Frame Grid.Column="1" x:Name="DashboardFrame" NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
