<Page x:Class="ShopAIDesktop.UI.Pages.Login.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopAIDesktop.UI.Pages.Login"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1200"
      Title="LoginPage">

    <!--Contenido Principal-->
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="40*" />
        </Grid.ColumnDefinitions>

        <!--Imagen-->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Image 
                Source="/Assets/Images/sign-in.png"
                Stretch="Fill"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
            />
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Iniciar Sesion"
               FontSize="28"
               FontWeight="SemiBold"
               HorizontalAlignment="Center" 
               Margin="0,8,0,0"/>

                <TextBlock Text="Accede con tu cuenta de ShopAI"
               Margin="0,8,0,32"
               HorizontalAlignment="Center" />


                <TextBlock Text="Correo Electronico"
               Margin="0,0,0,8" />

                <TextBox x:Name="EmailText" Style="{ StaticResource ShopAITextBox}" />

                <TextBlock Text="Contraseña"
               Margin="0,20,0,6" />

                <PasswordBox x:Name="PasswordText" Style="{StaticResource ShopAIPasswordBox}" />

                <TextBlock Text="¿Olvidate tu contraseña?"
               HorizontalAlignment="Center"
               Margin="0,10,0,10" />

                <Button x:Name="SignInButton" 
                        Style="{StaticResource PrimaryButton}"
                        Content="Iniciar Sesion" 
                        Click="HandleSignIn"/>

            </StackPanel>

        </Grid>
    </Grid>
</Page>
