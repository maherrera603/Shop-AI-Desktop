<Page x:Class="ShopAIDesktop.UI.Pages.Home.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopAIDesktop.UI.Pages.Home"
      xmlns:component="clr-namespace:ShopAIDesktop.UI.Components.CustomCard"
      xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage"
      Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="160"/>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto" MinHeight="200"/>
        </Grid.RowDefinitions>
        <!-- section cards -->
        <ScrollViewer x:Name="CardsScrollViewer"
            Grid.Row="0" 
            HorizontalScrollBarVisibility="Hidden" 
            VerticalScrollBarVisibility="Disabled"
            PreviewMouseLeftButtonDown="CardsScrollViewer_MouseLeftButtonDown"
            PreviewMouseMove="CardsScrollViewer_MouseMove"
            PreviewMouseLeftButtonUp="CardsScrollViewer_MouseLeftButtonUp" Cursor="Hand">
            <StackPanel Orientation="Horizontal" >
                <component:CustomCard x:Name="CardCategory"
                                      Height="160"
                                      Width="400"
                                      Margin="0, 0, 12,0"
                                      />

                <component:CustomCard x:Name="CardProduct"
                          Height="160"
                          Width="400"
                          Margin="12, 0, 12,0"
                          />

                <component:CustomCard x:Name="SalesProduct"
                  Height="160"
                  Width="400"
                  Margin="12, 0, 12,0"
                />
            </StackPanel>
        </ScrollViewer>

        <!-- section pending of orders  -->
        <Grid Grid.Row="1" Margin="0, 25, 0, 0" MinHeight="120">

            <Border Background="White"
                    BorderBrush="#D9CFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Assets/Icons/clock.svg"
                                             Width="38"
                                             Height="38"
                                             Margin="0,0,20,0"/>

                            <TextBlock Text="Ordenes Recientes"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#25105C"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="#4F1FA1"
                                 CornerRadius="6"
                                 HorizontalAlignment="Left"
                                 Padding="12,6"
                                 Margin="58,12,0,0" >

                            <TextBlock Text="STAND BY"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White" />
                        </Border>

                        <TextBlock Text="Esta seccion estara disponible cuando el servicio de ordenes este funcionando"
                                   FontSize="14"
                                   Foreground="#40356B"
                                   Margin="58,15,0,0" />

                    </StackPanel>

                    <svgc:SvgViewbox Grid.Column="1"
                                     Source="/Assets/Icons/pricetags.svg"
                                     Width="90"
                                     Height="90"
                                     Opacity="0.15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />


                </Grid>
                
            </Border>
        </Grid>

        <!--section add data-->
        <Grid Grid.Row="2" Margin="0,25,0,0">
            <Border Background="White"
                    BorderBrush="#E3DDF5"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="25, 10">

                <StackPanel>
                    
                    <!--Titulo-->
                    <TextBlock Text="Acciones rápidas"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#3F1B91"
                               Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal">
                        
                        <!--Nuevo producto-->
                        <Button Width="400"
                                Height="110"
                                Background="White"
                                BorderBrush="#E3DDF5"
                                BorderThickness="1"
                                Cursor="Hand"
                                Padding="15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                
                                <!--Icono-->
                                <Border Grid.Column="0"
                                        Width="65"
                                        Height="65"
                                        CornerRadius="33"
                                        Background="#EEE8FF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <svgc:SvgViewbox
                                        Source="/Assets/Icons/plus-circle.svg"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                </Border>
                                
                                <!--Texto-->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">

                                    <TextBlock
                                        Text="Nuevo Producto"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#351570" />
                                    
                                    <TextBlock
                                        Text="Agregar un nuevo producto al catalogo"
                                        FontSize="12"
                                        Foreground="#5F5675"
                                        TextWrapping="Wrap"
                                        Margin="0,5,0,0" />
                                </StackPanel>

                                <svgc:SvgViewbox Grid.Column="2"
                                    Source="/Assets/Icons/chevron-right.svg"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Button>


                        <!--Nueva Categoria-->
                        <Button Width="400"
                                Height="110"
                                Background="White"
                                BorderBrush="#E3DDF5"
                                BorderThickness="1"
                                Cursor="Hand"
                                Padding="15"
                                Margin="20,0,0,0"
                                >       

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <!--Icono-->
                                <Border Grid.Column="0"
                                        Width="65"
                                        Height="65"
                                        CornerRadius="33"
                                        Background="#EEE8FF"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    
                                    <svgc:SvgViewbox
                                        Source="/Assets/Icons/plus-circle.svg"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <!--Texto-->
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">

                                    <TextBlock
                                        Text="Nueva Categoria"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#351570" />

                                    <TextBlock
                                        Text="Agregar una nueva categoría al catalogo"
                                        FontSize="12"
                                        Foreground="#5F5675"
                                        TextWrapping="Wrap"
                                        Margin="0,5,0,0" />
                                </StackPanel>

                                <svgc:SvgViewbox Grid.Column="2"
                                    Source="/Assets/Icons/chevron-right.svg"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Button>


                    </StackPanel>
                                

                </StackPanel>
                
            </Border>
        </Grid>
    </Grid>
</Page>
