<Page x:Class="ShopAIDesktop.UI.Pages.Categories.CategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShopAIDesktop.UI.Pages.Categories"
      xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
      xmlns:customSearch="clr-namespace:ShopAIDesktop.UI.Components.CustomSearch"
      xmlns:dataTable="clr-namespace:ShopAIDesktop.UI.Components.DataTable"
      xmlns:customCardItem="clr-namespace:ShopAIDesktop.UI.Components.CustomCardItem" 
      xmlns:pagination="clr-namespace:ShopAIDesktop.UI.Components.Pagination"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CategoryPage">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--HEADER-->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            
            <StackPanel Grid.Column="0">
                <TextBlock
                    Text="Categorias"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#3F1B91" />

                <TextBlock
                    Text="Administra las categorias de tu catalogo"
                    FontSize="13"
                    Foreground="#6F6685"
                    Margin="0,6,0,0" />
            </StackPanel>

            <Button 
                Grid.Column="1"
                Width="170"
                Height="42"
                Margin="20,0,0,0"
                Background="#5522AB"
                Foreground="White"
                HorizontalAlignment="Right"
                BorderThickness="1"
                Cursor="Hand"
                Click="HandleNewCategoryButton_Click">
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                    <svgc:SvgViewbox Source="/Assets/Icons/plus.svg"
                                 Width="18"
                                 Height="18"
                                 Margin="0,0,8,0" />
                    <TextBlock
                    Text="Nueva Categoría"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                </StackPanel>

            </Button>

        </Grid>

        <!--FILTROS Y ORGANIZACION-->
        <customSearch:CustomSearch 
            Grid.Row="1" 
            x:Name="CustomSearchBar"
            SearchTrigged="CustomSearch_SearchTrigged"
            StatusChanged="CustomSearch_StatusChanged"
            ViewModeChanged="CustomSearch_ViewModeChanged"/>


        <!-- Fila 3: Contenido + Paginacion -->
        <Grid Grid.Row="2" Margin="0, 20, 0, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--Fila 3.1: Tabla / Tajetas-->
            <Grid Grid.Row="0" Margin="0, 15,0,0">
                <dataTable:DataTable 
                    x:Name="CategoriesTable"
                    Visibility="Visible"
                    ItemsSource="{Binding Categories}" />

                <ScrollViewer
                    x:Name="CategoriesCardsContainer"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Enlace directo a las propiedades del objecto Category -->
                                <customCardItem:CustomCardItem Title="{Binding Name}"
                                                               ImageUrl="{Binding ImageUrl}"
                                                               IsActive="{Binding IsActive}"
                                                               EditRequested="CatalogCardControl_EditRequested"
                                                               DeleteRequested="CatalogCardControl_DeleteRequested"
                                                               />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl> 
                </ScrollViewer>
            </Grid>
            
            
            
            <!--Fila 3.2: Paginacion-->
            <pagination:Pagination 
                x:Name="PaginationControl"
                Grid.Row="1"
                Margin="0,15,0,0" />



        </Grid>
    </Grid>
    
    
</Page>
