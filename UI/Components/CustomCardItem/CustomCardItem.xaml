<UserControl x:Name="CardRoot"
             x:Class="ShopAIDesktop.UI.Components.CustomCardItem.CustomCardItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopAIDesktop.UI.Components"
             xmlns:converter="clr-namespace:ShopAIDesktop.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Instancia del convertidor -->
        <converter:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#E4DDF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <!--Tarjeta Completa Clickeable Para Editar-->
    <Border Style="{StaticResource CardBorderStyle}"
            Width="280"
            Margin="10"
            Padding="12"
            Cursor="Hand"
            Background="Transparent"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Status Badge-->
                <RowDefinition Height="160" />
                <!-- Image container -->
                <RowDefinition Height="Auto" />
                <!-- Footer: Title + delete -->
            </Grid.RowDefinitions>

            <!-- 1. Badge de estado (Esquina superior Izquierda)-->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4, 0,0,8">
                <!-- Dot Indicator -->
                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#22C55E" />
                            <!-- Verde: activo -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, ElementName=CardRoot}" Value="False" >
                                    <Setter Property="Fill" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Texto de Estado -->
                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Activa" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, ElementName=CardRoot}" Value="False">
                                    <Setter Property="Text" Value="Inactiva" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!--2. CONTENEDOR DE IMAGEN (Abarca el centro)-->
            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Background="#F3F4F6">
                <Grid>
                    <!--Icono Placeholder si no hay Imagen-->
                    <TextBlock Text="🖼" FontSize="36" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Imagen de la entidad -->
                    <Image 
                        Source="{Binding ImageUrl, ElementName=CardRoot, Converter={StaticResource StringToImageSourceConverter}, TargetNullValue={x:Null}, FallbackValue={x:Null}}" 
                        Stretch="UniformToFill" 
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="4,12,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Title, ElementName=CardRoot}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#111827"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="DeleteButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Foreground="#EF4444" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>

    </Border>
</UserControl>
