<UserControl x:Name="HeaderRoot"
    x:Class="ShopAIDesktop.UI.Components.CustomHeader.CustomHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopAIDesktop.UI.Components.CustomHeader"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <StackPanel Grid.Column="0">
            <TextBlock
            Text="{Binding Title, ElementName=HeaderRoot}"
            FontSize="28"
            FontWeight="SemiBold"
            Foreground="#3F1B91" />

            <TextBlock
            Text="{Binding SubTitle, ElementName=HeaderRoot}"
            FontSize="13"
            Foreground="#6F6685"
            Margin="0,6,0,0" />
        </StackPanel>

        <Button 
        Grid.Column="1"
        Width="170"
        Height="42"
        Margin="20,0,0,0"
        Background="#5522AB"
        Foreground="White"
        HorizontalAlignment="Right"
        BorderThickness="1"
        Cursor="Hand"
        Click="HandleActionButton_Click">
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                <svgc:SvgViewbox Source="/Assets/Icons/plus.svg"
                         Width="18"
                         Height="18"
                         Margin="0,0,8,0" />
                <TextBlock
            Text="{Binding ActionButtonText, ElementName=HeaderRoot}"
            FontSize="13"
            FontWeight="SemiBold"
            VerticalAlignment="Center" />
            </StackPanel>

        </Button>

    </Grid>
</UserControl>
