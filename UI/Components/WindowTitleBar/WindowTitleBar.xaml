<UserControl x:Class="ShopAIDesktop.UI.Components.WindowTitleBar.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopAIDesktop.UI.Components.WindowTitleBar"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="800">

    <!--Barra Superior-->
    <Border DockPanel.Dock="Top" Height="30" Background="#4C1D95" MouseLeftButtonDown="HandleDrag"  CornerRadius="5,5,0,0" BorderBrush="White" BorderThickness="0,0,0,0.5">
        <DockPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" >
                
                <Button Height="20" Width="20"  Background="Transparent" Margin="5,0" Click="HandleMinimize">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMinimize, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgViewbox Source="pack://application:,,,/Assets/Icons/minus.svg" Height="10" Width="10" />
                </Button>
                
                <Button Height="20" Width="20" Background="Transparent" Margin="5,0" Click="HandleMaximize">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMaximize, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <svgc:SvgViewbox Source="/Assets/Icons/square.svg" Height="10" Width="10"/>
                </Button>
                <Button Height="20" Width="20" Background="Transparent" Margin="5,0,5,0" Click="HandleClose">
                    <svgc:SvgViewbox Source="/Assets/Icons/x.svg" Height="10" Width="10"/>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="White"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Margin="15,0" />
        </DockPanel>
    </Border>
</UserControl>
