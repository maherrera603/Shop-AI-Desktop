<Window x:Class="ShopAIDesktop.UI.Components.CustomAlert.CustomAlert"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopAIDesktop.UI.Components.CustomAlert"
             xmlns:components="clr-namespace:ShopAIDesktop.UI.Components.WindowTitleBar"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             Height="200" Width="400"
            WindowStyle="None"
            ResizeMode="NoResize" 
            WindowState="Normal" 
            Padding="0" 
            Margin="0" 
            WindowStartupLocation="CenterScreen"
            AllowsTransparency="True"
            Background="Transparent"
            
            >
    <Border Background="White"
            CornerRadius="5"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect 
                BlurRadius="15"
                ShadowDepth="4"
                Opacity="0.3"/>
        </Border.Effect>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="53" />
            </Grid.RowDefinitions>

            <components:WindowTitleBar Grid.Row="0" 
                                       Title="ShopAI - Alert" 
                                       IsMinimize="False" 
                                       IsMaximize="False"/>

            <Grid Grid.Row="1" Margin="25,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="70*" />
                </Grid.ColumnDefinitions>

                <svgc:SvgViewbox
                    x:Name="AlertIcon"
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0" />

                <TextBlock x:Name="MessageText"
                    Grid.Column="1" 
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="14"/>
            </Grid>

            <Button
                Grid.Row="2"
                Content="Aceptar"
                Width="100"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Margin="0,0,10,10"
                Click="HandleAccept"
                />
        </Grid>
    </Border>
</Window>
