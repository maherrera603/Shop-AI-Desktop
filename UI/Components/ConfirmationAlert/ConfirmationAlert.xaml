<Window x:Class="ShopAIDesktop.UI.Components.ConfirmationAlert.ConfirmationAlert"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopAIDesktop.UI.Components.ConfirmationAlert"
        xmlns:component="clr-namespace:ShopAIDesktop.UI.Components.WindowTitleBar"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        mc:Ignorable="d"
        Title="ConfirmationAlert" Height="450" Width="800">
    <Border 
        Background="White"
        CornerRadius="12"
        BorderBrush="#DDD5F5"
        BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!--Window title bar-->
            <component:WindowTitleBar Grid.Row="0"
                                      Title="{Binding TitleText, RelativeSource={RelativeSource AncestorType=Window}}"
                                      IsMaximize="False"
                                      IsMinimize="False" />
            
            <!--Content-->
            <Grid Grid.Row="1"
                  Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!--Message-->
                <TextBlock Grid.Row="0"
                           Text="{Binding MessageText, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="14"
                           Foreground="#292331"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5" />

                <TextBlock Grid.Row="1"
                           Text="Esta accíon no se puede deshacer."
                           FontSize="12"
                           Foreground="#D32F2F"
                           TextWrapping="Wrap"
                           Margin="0,0,0,30" />

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Width="100"
                            Height="36"
                            Background="#5522AB"
                            Foreground="White"
                            Margin="0,0,10,0"
                            BorderThickness="0"
                            Click="HandleCancel_Click"
                            Cursor="Hand" />

                    <Button Content="Eliminar"
                            Background="#D32F2F"
                            Foreground="White"
                            BorderThickness="0"
                            Width="100"
                            Height="36"
                            Click="HandleConfirm_Click"
                            Cursor="Hand" />
                </StackPanel>

            </Grid>
            
        </Grid>
        
    </Border>
</Window>
