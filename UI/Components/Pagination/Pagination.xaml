<UserControl x:Class="ShopAIDesktop.UI.Components.Pagination.Pagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopAIDesktop.UI.Components.Pagination"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--Informacion-->
        <TextBlock
            Grid.Column="0"
            Text="Mostrando 1-10 de 45"
            FontSize="12"
            Foreground="#6F6685"
            VerticalAlignment="Center" />
        
        <!--Controles-->
        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            
            <!--Anterior-->
            <Button
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#6F6685"
                Cursor="Hand"
                ToolTip="Pagina Anterior">
                
                <TextBlock
                    Text="&lt;"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Button>

            <!-- PÁGINA 1 -->
            <Button
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Background="#5522AB"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>
                    </ControlTemplate>
                </Button.Template>

                <TextBlock
                    Text="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

            <!-- PÁGINA 2 -->
            <Button
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Background="Transparent"
                Foreground="#6F6685"
                BorderThickness="0"
                Cursor="Hand">

                <TextBlock
                    Text="2"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

            <!-- PÁGINA 3 -->
            <Button
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Background="Transparent"
                Foreground="#6F6685"
                BorderThickness="0"
                Cursor="Hand">

                <TextBlock
                    Text="3"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

            <!-- PÁGINA 4 -->
            <Button
                Width="32"
                Height="32"
                Margin="0,0,4,0"
                Background="Transparent"
                Foreground="#6F6685"
                BorderThickness="0"
                Cursor="Hand">

                <TextBlock
                    Text="4"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>

            <!-- PÁGINA 5 -->
            <Button
                Width="32"
                Height="32"
                Margin="0"
                Background="Transparent"
                Foreground="#6F6685"
                BorderThickness="0"
                Cursor="Hand">

                <TextBlock
                    Text="5"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

            </Button>





            <!--Siguiente-->
            <Button
                Width="32"
                Height="32"
                Margin="4,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#6fff85"
                Cursor="Hand"
                ToolTip="Pagina Siguiente" >

                <TextBlock
                    Text=">"
                    FontSize="20"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
