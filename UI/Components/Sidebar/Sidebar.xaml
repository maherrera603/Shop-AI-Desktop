<UserControl x:Class="ShopAIDesktop.UI.Components.Sidebar.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShopAIDesktop.UI.Components.Sidebar"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             Background="Transparent"
             >
    <Border Background="#4C1D95">
        <Grid Margin="15" >
            <Grid.RowDefinitions>
                <!--Header-->
                <RowDefinition Height="70" />
                <!--Menu-->
                <RowDefinition Height="*" />
                
                <!--Footer-->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                
                <Image Source="/Assets/Images/Logo.png"
                        Width="150"
                        Height="150"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                
                
            </Grid>

            <!-- ========================= -->
            <!-- MENU -->
            <!-- ========================= -->
            <StackPanel Grid.Row="1"
                        Margin="0,20,0,0">
                
                
                <!-- Aquí irán los elementos del menú -->
                <Button Height="45"
                        Margin="0,0,0,8"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,0" 
                        Cursor="Hand"
                        Click="HandleHomePage">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Assets/Icons/home.svg" Height="20" Width="20"/>
                            <TextBlock Text="Inicio"
                                        FontSize="14"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0" />
                        </StackPanel>
                </Button>
                
                <Button Height="45"
                        Margin="0,0,0,8"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,0" 
                        Cursor="Hand"
                        Click="HandleCategoryPage">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Assets/Icons/pricetags.svg" Height="20" Width="20"/>
                        <TextBlock Text="Categorias"
                                   FontSize="14"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Button>


                <Button Height="45"
                        Margin="0,0,0,8"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,0" 
                        Cursor="Hand">  
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Source="/Assets/Icons/box.svg" Height="20" Width="20"/>
                        <TextBlock Text="Productos"
                                   FontSize="14"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->
            <Border Grid.Row="2"
                    BorderBrush="#FFFFFF"
                    BorderThickness="0,0.5,0,0"
                    Padding="0, 15,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,10" >

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="#FFFFFF"
                                HorizontalAlignment="Center">

                            <svgc:SvgViewbox Source="/Assets/Icons/user.svg" Height="26" Width="26"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="Administrador"
                                       FontSize="11"
                                       Foreground="#d9cfff"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>


                    <Button Grid.Row="1"
                             Height="42"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Left"
                             Cursor="Hand"
                             Padding="10,0"
                             >

                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Assets/Icons/settings.svg" Height="24" Width="24"/>
                            <TextBlock Text="Perfil"
                                        FontSize="13"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>


                    <Button Grid.Row="2"
                            Height="42"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            Padding="10,0"
                            Click="HandleLogout">
                        
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox Source="/Assets/Icons/log-out.svg" Height="24" Width="24"/>
                            <TextBlock Text="Cerrar Sesion"
                                       FontSize="13"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>


                </Grid>
                
            </Border>
        </Grid>
            
    </Border>
</UserControl>
